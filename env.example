# ── Copia esto a .env y llena los valores ──

# Puerto (los hostings suelen inyectarlo solos)
PORT=3000

# json = archivo en disco · postgres = base de datos
STORAGE=postgres

# Cadena de conexión. Neon y Supabase te la dan hecha.
DATABASE_URL=postgres://usuario:clave@host:5432/base

# Ponlo en false SOLO para un Postgres local sin TLS
# PGSSL=false

USUARIO_ACCESO=comms
CLAVE_ACCESO=cambia-esta-clave

# Solo si el front vive en otro dominio (separa con comas)
# ORIGENES=https://comms.tudominio.com

NODE_ENV=production

# CLIENT_ID=00000000-0000-0000-0000-000000000000
# CLIENT_SECRET=el-secreto-de-la-app-registrada
# SP_SITE=/sites/TraficoComms

# Autenticación con la cuenta corporativa en vez de clave compartida.
